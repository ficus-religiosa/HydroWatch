# HydroWatch backend settings. Copy to .env and change what you need - every line is optional.
# Relative paths are relative to this backend folder.

# --- model
MODEL_WEIGHTS=weights/best.pt
DEVICE=auto                  # auto = GPU if available, else CPU. Or cuda:0 / cpu
HALF=1                       # fp16 on the GPU
IMGSZ=1280                   # must match training
DEFAULT_CONFIDENCE=0.3       # used when the website doesn't send one
BATCH=4                      # video frames per GPU call; lower to 2 if you hit out-of-memory
MODEL_NOTE=HydroNet oracle_v3 - held-out TEST: mAP50 0.795, mAP50-95 0.576

# --- database (created automatically on first start)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=hydrowatch

# --- files and limits
STORAGE_DIR=storage
MAX_FILES=20
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=600
RENDER_VIDEOS=1              # 1 = make the annotated MP4 right after each analysis; 0 = only when downloaded

# --- web
HOST=127.0.0.1               # 0.0.0.0 lets other devices on your network open the site
PORT=8000
CORS_ORIGINS=*
FRONTEND_DIST=../frontend/dist
GEOCODER=nominatim           # place-name lookup via OpenStreetMap; "off" to disable
